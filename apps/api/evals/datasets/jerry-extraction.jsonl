{"id": "ext-001", "intent": "stats", "message": "I'm 6 foot 1, 190 pounds, and I throw right-handed", "expect": [{"path": "performance.physicalProfile.height", "contains": "6"}, {"path": "performance.physicalProfile.weight", "contains": "190"}, {"path": "performance.physicalProfile.dominantSide", "contains": "right"}]}
{"id": "ext-002", "intent": "stats", "message": "My pop time is 1.92 seconds and I threw out 40 percent of base stealers", "expect": [{"path": "performance.stats", "present": true}]}
{"id": "ext-003", "intent": "stats", "message": "I batted .410 with 8 home runs and 31 RBIs in 26 games this season", "expect": [{"path": "performance.stats", "present": true}]}
{"id": "ext-004", "intent": "stats", "message": "I had knee surgery last year but I'm fully cleared and back to full speed", "expect": [{"path": "performance.physicalStatus", "present": true}]}
{"id": "ext-005", "intent": "academic", "message": "I have a 3.8 GPA and scored 1240 on the SAT", "expect": [{"path": "academic.gpa", "equals": 3.8}, {"path": "academic.satAct", "equals": 1240}]}
{"id": "ext-006", "intent": "academic", "message": "I want to study business administration in college", "expect": [{"path": "academic.intendedMajor", "contains": "business"}]}
{"id": "ext-007", "intent": "academic", "message": "I graduate in 2027 with a 3.9 weighted GPA", "expect": [{"path": "academic.graduationYear", "equals": 2027}]}
{"id": "ext-008", "intent": "personal", "message": "I'm a catcher at Westminster Christian School in Miami, Florida", "expect": [{"path": "identity.position", "contains": "catcher"}, {"path": "identity.school", "contains": "westminster"}, {"path": "identity.location", "contains": "miami"}]}
{"id": "ext-009", "intent": "personal", "message": "I play baseball, class of 2027", "expect": [{"path": "identity.sport", "contains": "baseball"}, {"path": "identity.graduationYear", "equals": 2027}]}
{"id": "ext-010", "intent": "availability", "message": "I need a full athletic scholarship and I'd prefer to stay in the Southeast", "expect": [{"path": "availability.scholarshipNeed", "equals": true}, {"path": "availability.preferredRegions", "contains": "southeast"}]}
{"id": "ext-011", "intent": "availability", "message": "I'm not in the transfer portal", "expect": [{"path": "availability.transferPortal", "equals": false}]}
{"id": "ext-012", "intent": "media", "message": "My highlights are at https://example.com/jerry-highlights and my Hudl is https://example.com/jerry-hudl", "expect": [{"path": "media.highlightUrls", "contains": "example.com"}]}
{"id": "ext-013", "intent": "recruiting", "message": "My goal is to start at a D1 program and I want to decide before spring of my senior year", "expect": [{"path": "availability.competitiveLevelGoal", "contains": "d1"}, {"path": "availability.timeline", "present": true}]}
{"id": "ext-014", "intent": "character", "message": "I'm the team captain, I take coaching well, and I bounce back fast after a bad game", "expect": [{"path": "character.leadership", "present": true}]}
