{
  "name": "@firststringers/database",
  "version": "0.1.0",
  "main": "./index.ts",
  "scripts": {
    "prisma": "prisma",
    "migrate:reset": "prisma migrate reset --schema=./prisma/schema.prisma",
    "migrate:dev": "prisma migrate dev --schema=./prisma/schema.prisma",
    "db:seed": "prisma db seed --schema=./prisma/schema.prisma",
    "postinstall": "prisma generate",
    "db:generate": "dotenv -e ../../.env -- prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev",
    "db:push": "dotenv -e ../../.env -- prisma db push",
    "db:studio": "dotenv -e ../../.env -- prisma studio",
    "seed": "dotenv -e ../../.env -- ts-node --project tsconfig.json -r tsconfig-paths/register prisma/seed.ts",
    "test": "node --test -r ts-node/register prisma/__tests__/*.spec.ts",
    "demo:athletes": "ts-node --project tsconfig.json prisma/import-demo-athletes.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcrypt": "^6.0.0",
    "pg": "^8.21.0"
  },
  "devDependencies": {
    "@types/bcrypt": "^6.0.0",
    "@types/node": "^25.8.0",
    "dotenv-cli": "^11.0.0",
    "prisma": "^6.19.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.2"
  }
}
