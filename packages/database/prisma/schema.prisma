generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id         String      @id @default(uuid())
  name       String
  createdAt  DateTime    @default(now())
  athletes   Athlete[]
  recruiters Recruiter[]
}

model Athlete {
  id             String               @id @default(uuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id])
  email          String               @unique
  name           String
  sport          String?
  position       String?
  dossier        Dossier?
  sessions       JerrySession[]
  user           User?
  conversations  DirectConversation[]
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
}

model Dossier {
  id            String   @id @default(uuid())
  athleteId     String   @unique
  athlete       Athlete  @relation(fields: [athleteId], references: [id])
  data          Json     @default("{}")
  completeness  Float    @default(0)
  narrative     String?
  advocacyScore Float?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model JerrySession {
  id        String   @id @default(uuid())
  athleteId String   @unique
  athlete   Athlete  @relation(fields: [athleteId], references: [id])
  messages  Json     @default("[]")
  status    String   @default("active")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  currentPitch String?
  pitchVersion Int      @default(0)
  lastPitchAt  DateTime? 
}

model Recruiter {
  id                  String               @id @default(uuid())
  organizationId      String
  organization        Organization         @relation(fields: [organizationId], references: [id])
  email               String               @unique
  name                String
  // Program info collected during Billy onboarding
  university          String?
  location            String?
  scholarshipType     String?              // "full" | "partial" | "financial_aid"
  sport               String?
  gender              String?              // "male" | "female" | "both"
  division            String?              // "D1" | "D2" | "D3" | "NAIA" | "JUCO"
  openings            Int?
  onboardingCompleted Boolean              @default(false)
  pitch               String?
  // Verification: pending → under_review → verified | rejected
  verificationStatus  String               @default("pending") // "pending" | "under_review" | "verified" | "rejected"
  verificationTitle   String?              // role/title at the organization
  verificationWebsite String?              // organization website
  verificationLinkedIn String?             // recruiter's LinkedIn URL
  verifiedAt          DateTime?
  createdAt           DateTime             @default(now())
  user                User?
  billyMessages       BillyMessage[]
  conversations       DirectConversation[]
}

model User {
  id              String             @id @default(uuid())
  email           String             @unique
  password        String
  role            String             @default("ATHLETE")
  athleteId       String?            @unique
  athlete         Athlete?           @relation(fields: [athleteId], references: [id])
  recruiterId     String?            @unique
  recruiter       Recruiter?         @relation(fields: [recruiterId], references: [id])
  emailVerified   Boolean            @default(false)
  emailVerifiedAt DateTime?
  createdAt       DateTime           @default(now())
  verificationCodes VerificationCode[]
}

model VerificationCode {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  code      String   // hashed
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

model DirectConversation {
  id          String          @id @default(uuid())
  recruiterId String
  recruiter   Recruiter       @relation(fields: [recruiterId], references: [id])
  athleteId   String
  athlete     Athlete         @relation(fields: [athleteId], references: [id])
  status      String          @default("pending") // "pending" | "accepted" | "declined"
  messages    DirectMessage[]
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([recruiterId, athleteId])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String             @id @default(uuid())
  conversationId String
  conversation   DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderRole     String
  senderId       String
  content        String
  readAt         DateTime?
  createdAt      DateTime           @default(now())

  @@map("direct_messages")
}

model BillyMessage {
  id          String    @id @default(uuid())
  recruiterId String
  recruiter   Recruiter @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  role        String
  content     String
  metadata    Json?
  createdAt   DateTime  @default(now())

  @@map("billy_messages")
}

model BillyConversation {
  id             String   @id @default(uuid())
  recruiterId    String
  title          String   @default("New search")
  messages       Json     @default("[]")
  searchCriteria Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([recruiterId])
  @@map("billy_conversations")
}